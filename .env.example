# Copy to .env and adjust. All values are optional; defaults shown.

# --- Server ---
PORT=4000                      # HTTP/WebSocket port
DB_PATH=data/events.db         # SQLite file (holds agents, worlds, event log)
STATIC_DIR=web/dist            # built SPA to serve; unset/absent in dev (Vite serves it)

# --- LLM (only needed for `api` adapter agents) ---
ANTHROPIC_API_KEY=             # your Anthropic API key

# --- CLI-agent runtime pool (only affects `cli` adapter agents) ---
CLI_MAX_CONCURRENT=3           # max CLI subprocesses running at once
CLI_TIMEOUT_MS=90000           # per-call timeout (ms)
CLI_MAX_CALLS_PER_HOUR=500     # resettable hourly call budget across all CLI agents
